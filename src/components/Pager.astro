---
interface Props {
    /** Term URL without a trailing slash, e.g. `/categories/java`. */
    base: string;
    page: number;
    total: number;
}

const { base, page, total } = Astro.props;

// Page 1 lives at the term URL; later pages at `<base>/page/<n>/`, matching the
// paths the Hugo site published.
const href = (n: number) => (n === 1 ? `${base}/` : `${base}/page/${n}/`);
---

{total > 1 && (
    <nav class="xl-pager" aria-label="分页">
        {page > 1 ?
            <a href={href(page - 1)} rel="prev">
                上一页
            </a>
        :   <span />}
        <span class="xl-pager-count">
            {page} / {total}
        </span>
        {page < total ?
            <a href={href(page + 1)} rel="next">
                下一页
            </a>
        :   <span />}
    </nav>
)}

<style>
    .xl-pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--sl-color-hairline);
        font-size: var(--sl-text-sm);
    }

    .xl-pager-count {
        color: var(--sl-color-gray-3);
    }
</style>
