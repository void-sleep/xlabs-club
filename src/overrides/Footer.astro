---
// Footer: build note on the left, "Give Me a Star" on the right.
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
---

<footer class="sl-flex">
    <div class="meta sl-flex">
        <EditLink />
        <LastUpdated />
    </div>
    <Pagination />
    <div class="xl-footer sl-flex">
        <p>Powered by Astro, Starlight and Starlight Blog</p>
        <p>
            Give Me a <a href="https://github.com/void-sleep/xlabs-club/">Star</a>
        </p>
    </div>
    {config.credits && (
        <a class="kudos sl-flex" href="https://starlight.astro.build">
            <Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
        </a>
    )}
</footer>

<style>
    footer {
        flex-direction: column;
        gap: 1.5rem;
    }

    .meta {
        gap: 0.75rem 3rem;
        justify-content: space-between;
        flex-wrap: wrap;
        margin-top: 3rem;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }

    .xl-footer {
        justify-content: space-between;
        gap: 0.75rem 2rem;
        flex-wrap: wrap;
        margin-top: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--sl-color-hairline);
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }

    .xl-footer p {
        margin: 0;
    }

    .xl-footer a {
        color: var(--sl-color-gray-2);
    }

    .kudos {
        align-items: center;
        gap: 0.5em;
        margin: 1.5rem auto;
        font-size: var(--sl-text-xs);
        text-decoration: none;
        color: var(--sl-color-gray-3);
    }

    .kudos:hover {
        color: var(--sl-color-white);
    }
</style>
